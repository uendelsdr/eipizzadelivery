# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase Dashboard > Project Settings > API)
# NEXT_PUBLIC_SUPABASE_ANON_KEY = a "Publishable key" (sb_publishable_...), NUNCA a "Secret key"

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL pública do app (usada nos links dentro dos e-mails de notificação)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Notificações por e-mail (Resend: https://resend.com) ---
# Chave de API do Resend
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Remetente dos e-mails (precisa ser de um domínio verificado no Resend)
EMAIL_FROM="Gestão de Demandas <notificacoes@seudominio.com.br>"

# --- Verificação diária de prazos vencidos ---
# Secret key do Supabase (Project Settings > API Keys > Secret keys) — NUNCA exponha essa chave no frontend
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Senha aleatória própria sua, só para proteger o endpoint de verificação de prazos
CRON_SECRET=escolha-uma-senha-aleatoria-aqui
